MODULE GET_CUSTOMER INPUT.
  CLEAR: GS_HEADER-NAME1,
          GS_HEADER-STRAS,
          GS_HEADER-TELFX.

  IF GS_HEADER-KHACHHANG IS NOT INITIAL.

    CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
      EXPORTING
        INPUT  = GS_HEADER-KHACHHANG
      IMPORTING
        OUTPUT = GS_HEADER-KHACHHANG.

    SELECT SINGLE NAME1 STRAS TELFX
    INTO (GS_HEADER-NAME1, GS_HEADER-STRAS, GS_HEADER-TELFX)
    FROM KNA1
    WHERE KUNNR = GS_HEADER-KHACHHANG.

    IF SY-SUBRC <> 0.
      MESSAGE 'Khách hàng không ton tai' TYPE 'E'.
    ENDIF.

  ENDIF.

ENDMODULE.

MODULE USER_COMMAND_2000 INPUT.
  PERFORM USER_COMMAND_2000.
ENDMODULE.

MODULE EXIT_COMMAND_2000 INPUT.
  LEAVE TO SCREEN 0.
ENDMODULE.

MODULE USER_COMMAND_3000 INPUT.
  PERFORM USER_COMMAND_3000.
ENDMODULE.

MODULE EXIT_COMMAND_3000 INPUT.
  LEAVE TO SCREEN 0.
ENDMODULE.