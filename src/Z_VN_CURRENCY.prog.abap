*&---------------------------------------------------------------------*
*& Include Z_VN_CURRENCY
*&---------------------------------------------------------------------*
*REPORT Z_VN_CURRENCY.
*
*START-OF-SELECTION.
*
  TYPES: ty_amount type p LENGTH 16 DECIMALS 0.
*
*  DATA: LV_RESULT TYPE STRING.
*  PERFORM VND_TO_TEXT USING 1001001 CHANGING LV_RESULT.
*  WRITE LV_RESULT.
*



FORM VND_TO_TEXT USING VALUE(NUMBER) TYPE ty_amount CHANGING LV_RESULT TYPE STRING.

  DATA : LV_GROUP       TYPE I,
         LV_TEXT        TYPE STRING,
         LV_NUMBER      TYPE I,
         LV_INDEX       TYPE I,
         LV_LEN         TYPE I,
         LV_NUMBER_TEXT TYPE STRING,
         LT_NUMBERS     TYPE STANDARD TABLE OF I WITH EMPTY KEY.

  CLEAR LV_RESULT.
*  CLEAR LT_NUMBERS.

  IF NUMBER IS INITIAL OR NUMBER = 0.
    LV_RESULT = 'KHÔNG ÐÔNG'.
    RETURN.
  ENDIF.

  WHILE NUMBER > 0.
    LV_GROUP = NUMBER MOD 1000.
    NUMBER = NUMBER DIV 1000.

    APPEND LV_GROUP TO LT_NUMBERS.

  ENDWHILE.

  LV_INDEX = LINES( LT_NUMBERS ).
  LV_LEN = LINES( LT_NUMBERS ).

  WHILE LV_INDEX > 0.

    READ TABLE LT_NUMBERS INTO LV_NUMBER INDEX LV_INDEX.

    PERFORM CREATE_UNIT USING LV_INDEX CHANGING LV_TEXT.

    IF LV_NUMBER <> 0.

      PERFORM GROUP_NUMBER_TO_TEXT USING LV_NUMBER LV_LEN LV_INDEX CHANGING LV_NUMBER_TEXT.
      LV_RESULT = |{ LV_RESULT } { LV_NUMBER_TEXT } { LV_TEXT }|.
    ENDIF.

    LV_INDEX = LV_INDEX - 1.

  ENDWHILE.

  LV_RESULT = |{ LV_RESULT } ÐÔNG|.
  CONDENSE LV_RESULT.

ENDFORM.


FORM NUMBER_TO_TEXT USING IV_NUMBER TYPE I CHANGING CV_RESULT TYPE STRING.
  CASE IV_NUMBER.
    WHEN 1.
      CV_RESULT = 'MOT'.
    WHEN 2.
      CV_RESULT = 'HAI'.
    WHEN 3.
      CV_RESULT = 'BA'.
    WHEN 4.
      CV_RESULT = 'BON'.
    WHEN 5.
      CV_RESULT = 'NAM'.
    WHEN 6.
      CV_RESULT = 'SAU'.
    WHEN 7.
      CV_RESULT = 'BAY'.
    WHEN 8.
      CV_RESULT = 'TAM'.
    WHEN 9.
      CV_RESULT = 'CHIN'.
    WHEN OTHERS.
      CV_RESULT = ''.
  ENDCASE.
ENDFORM.

FORM CREATE_UNIT USING IV_NUMBER TYPE I CHANGING CV_RESULT TYPE STRING.
  CASE IV_NUMBER.
    WHEN 4.
      CV_RESULT = 'TY'.
    WHEN 3.
      CV_RESULT = 'TRIEU'.
    WHEN 2.
      CV_RESULT = 'NGHÌN'.
    WHEN OTHERS.
      CV_RESULT = ''.
  ENDCASE.
ENDFORM.

FORM GROUP_NUMBER_TO_TEXT
      USING IV_NUMBER TYPE I
            LV_INDEX TYPE I
            INDEX TYPE I
      CHANGING CV_RESULT TYPE STRING.

  DATA: TRAM_IV_UNIT  TYPE I,
        CHUC_IV_UNIT  TYPE I,
        DONVI_IV_UNIT TYPE I,
        CV_TEXT       TYPE STRING.

  CLEAR: CV_RESULT.

  TRAM_IV_UNIT = IV_NUMBER DIV 100. " TRAM
  CHUC_IV_UNIT = ( IV_NUMBER MOD 100 ) DIV 10. " CHUC
  DONVI_IV_UNIT = IV_NUMBER MOD 10. " DON VI

  IF TRAM_IV_UNIT <> 0.
    PERFORM NUMBER_TO_TEXT USING TRAM_IV_UNIT CHANGING CV_TEXT.
    CV_RESULT = |{ CV_TEXT } TRAM|.
  ELSEIF ( TRAM_IV_UNIT = 0 AND LV_INDEX <> INDEX ).
    CV_RESULT = |KHÔNG TRAM|.
  ENDIF.

  IF CHUC_IV_UNIT = 1.
    CV_RESULT = |{ CV_RESULT } MUOI|.
  ELSEIF CHUC_IV_UNIT > 1.
    PERFORM NUMBER_TO_TEXT USING CHUC_IV_UNIT CHANGING CV_TEXT.
    CV_RESULT = |{ CV_RESULT } { CV_TEXT } MUOI|.
  ENDIF.

  IF DONVI_IV_UNIT <> 0.

    IF LV_INDEX <> INDEX AND ( chuc_IV_UNIT = 0 OR donvi_IV_UNIT = 0 ).
      CV_RESULT = |{ CV_RESULT } LE|.
    ENDIF.

    IF CHUC_IV_UNIT <> 0 and donvi_IV_UNIT = 5.
      CV_TEXT = 'LAM'.
    ELSE.
      PERFORM NUMBER_TO_TEXT USING DONVI_IV_UNIT CHANGING CV_TEXT.
    ENDIF.

    CV_RESULT = |{ CV_RESULT } { CV_TEXT }|.
  ENDIF.

ENDFORM.