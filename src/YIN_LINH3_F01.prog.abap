FORM CREATE_ORDER .

  DATA: LS_KUNNR TYPE KUNNR.

  DATA: LT_KNA1 TYPE TABLE OF KNA1,
        LS_KNA1 TYPE KNA1.

  CLEAR: GS_HEADER.
  CLEAR: GT_ALV_3000.

  SELECT MAX( DHID )
    FROM YTB_DOND INTO @GV_MAX_DHID.

  GS_HEADER-DHID = GV_MAX_DHID + 1.



  GS_HEADER-NGAYDH = SY-DATUM.
  GS_HEADER-NGAYGIAO = SY-DATUM + 3.
  GS_HEADER-KHACHHANG = LS_KUNNR.
  GS_HEADER-TRANGTHAI = 'NEW'.

  SELECT KUNNR NAME1 STRAS
  INTO CORRESPONDING FIELDS OF TABLE LT_KNA1
  FROM KNA1
  WHERE KUNNR = GS_HEADER-KHACHHANG.

  IF LT_KNA1[] IS NOT INITIAL.
    READ TABLE LT_KNA1 INTO LS_KNA1 INDEX 1.
    GS_HEADER-NAME1 = LS_KNA1-NAME1.
    GS_HEADER-TELFX = LS_KNA1-TELFX.
    GS_HEADER-STRAS = LS_KNA1-STRAS.
  ENDIF.

  GS_HEADER-NEW = ABAP_TRUE.
  G_MODE_INS_UPD_DEL = 'I'.
  PERFORM BUILD_FCAT_ALV2.

*  PERFORM GET_DATA_3000.
  CALL SCREEN 3000.



  G_MODE_INS_UPD_DEL = ''.

  IF GW_SAVE = 'X'.
    PERFORM GET_DATA.
    PERFORM REFRESH_ALV.
  ENDIF.
  GW_SAVE = '' .
ENDFORM.

FORM GET_HEADER_DETAIL USING IP_DOCU TYPE YST_LINH3_MATERIAL
                             IP_TYPE TYPE CHAR10
                        CHANGING OP_ERROR TYPE CHAR1 .

  CLEAR: OP_ERROR.
  "
  IF IP_TYPE = 'GET_DATA' .

    CLEAR: GS_HEADER, GT_ALV_3000.
    "HEADER
*    GS_HEADER = IP_DOCU .

    SELECT SINGLE DONH~DHID,
        DONH~NGAYDH,
        DONH~NGAYGIAO,
        DONH~TRANGTHAI,
        DONH~KHACHHANG,
      KH~NAME1,
        KH~TELFX,
        KH~STRAS,
        DONH~GHICHU

  FROM YTB_DONH AS DONH
  LEFT JOIN KNA1 AS KH ON KH~KUNNR = DONH~KHACHHANG
  WHERE DONH~DHID = @IP_DOCU-DHID
  INTO CORRESPONDING FIELDS OF @GS_HEADER.

    IF SY-SUBRC <> 0.
      OP_ERROR = ABAP_TRUE.
      RETURN.
    ENDIF.

    "ALV NGOÀI
    SELECT  DOND~DHID,
        DOND~ITNUM,
        DOND~HHID,
        HANG~MAHANG,
        HANG~TENHANG,
        HANG~DVT,
        DOND~SOLUONG,
        DOND~DONGIA,
        HANG~TIENTE,
*      DONH~THANHTIEN,
      DOND~MOTA,
      DOND~UPDDATE,
      DOND~UPDTIME,
      DOND~UPDUSR,
      DOND~CRTDATE,
      DOND~CRTTIME,
      DOND~CRTUSR


  FROM  YTB_DOND AS DOND
  LEFT JOIN YTB_DONH AS DONH ON DONH~DHID = DOND~DHID
  LEFT JOIN YTB_HANG AS HANG ON DOND~HHID = HANG~HHID
  WHERE DONH~DHID = @IP_DOCU-DHID
  INTO CORRESPONDING FIELDS OF TABLE @GT_ALV_3000.

    LOOP AT GT_ALV_3000 ASSIGNING FIELD-SYMBOL(<LS_DETAIL>).
      <LS_DETAIL>-THANHTIEN =
        <LS_DETAIL>-SOLUONG * <LS_DETAIL>-DONGIA.
    ENDLOOP.

  ELSEIF IP_TYPE = 'SET_DATA'.
    PERFORM GET_DATA.
    PERFORM REFRESH_ALV.
  ENDIF.
ENDFORM .

FORM CHANGE_GRIDROW .
  DATA: LS_STYLE TYPE LVC_S_STYL,
        LT_STYLE TYPE LVC_T_STYL.

  READ TABLE GT_ALV_3000 TRANSPORTING NO FIELDS WITH KEY CHECK = ABAP_TRUE.
  IF SY-SUBRC <> 0.
    MESSAGE 'Choose 1 item!' TYPE 'S' DISPLAY LIKE 'E'.
    EXIT.
  ENDIF.

  LOOP AT GT_ALV_3000 ASSIGNING FIELD-SYMBOL(<FS_LIST>) WHERE CHECK = ABAP_TRUE.

    CLEAR: LS_STYLE, LT_STYLE.

    IF <FS_LIST>-CHANGE = ABAP_TRUE.
      LS_STYLE-STYLE = CL_GUI_ALV_GRID=>MC_STYLE_DISABLED.
      <FS_LIST>-CHANGE = ABAP_FALSE.
    ELSE.
      LS_STYLE-STYLE = CL_GUI_ALV_GRID=>MC_STYLE_ENABLED.
      <FS_LIST>-CHANGE = ABAP_TRUE.
    ENDIF.
    "
    LS_STYLE-FIELDNAME = 'CHECK'.
    INSERT LS_STYLE INTO TABLE LT_STYLE.
    LS_STYLE-FIELDNAME = 'DHID'.
    LS_STYLE-STYLE = CL_GUI_ALV_GRID=>MC_STYLE_DISABLED.
    INSERT LS_STYLE INTO TABLE LT_STYLE.
    LS_STYLE-FIELDNAME = 'ITNUM'.
    INSERT LS_STYLE INTO TABLE LT_STYLE.
    LS_STYLE-FIELDNAME = 'HHID'.
    LS_STYLE-STYLE = CL_GUI_ALV_GRID=>MC_STYLE_ENABLED.
    INSERT LS_STYLE INTO TABLE LT_STYLE.
    LS_STYLE-FIELDNAME = 'MAHANG'.
    LS_STYLE-STYLE = CL_GUI_ALV_GRID=>MC_STYLE_DISABLED.
    INSERT LS_STYLE INTO TABLE LT_STYLE.
    LS_STYLE-FIELDNAME = 'TENHANG'.
    INSERT LS_STYLE INTO TABLE LT_STYLE.
    LS_STYLE-FIELDNAME = 'DVT'.
    INSERT LS_STYLE INTO TABLE LT_STYLE.
    LS_STYLE-FIELDNAME = 'SOLUONG'.
    LS_STYLE-STYLE = CL_GUI_ALV_GRID=>MC_STYLE_ENABLED.
    INSERT LS_STYLE INTO TABLE LT_STYLE.
    LS_STYLE-FIELDNAME = 'DONGIA'.
    INSERT LS_STYLE INTO TABLE LT_STYLE.
    LS_STYLE-FIELDNAME = 'TIENTE'.
    INSERT LS_STYLE INTO TABLE LT_STYLE.
    LS_STYLE-FIELDNAME = 'THANHTIEN'.
    LS_STYLE-STYLE = CL_GUI_ALV_GRID=>MC_STYLE_DISABLED.
    INSERT LS_STYLE INTO TABLE LT_STYLE.
    "LS_STYLE-STYLE = CL_GUI_ALV_GRID=>MC_STYLE_ENABLED.
    LS_STYLE-FIELDNAME = 'MOTA'.
    LS_STYLE-STYLE = CL_GUI_ALV_GRID=>MC_STYLE_ENABLED.
    INSERT LS_STYLE INTO TABLE LT_STYLE.
    LS_STYLE-FIELDNAME = 'UPDDATE'.
    LS_STYLE-STYLE = CL_GUI_ALV_GRID=>MC_STYLE_DISABLED.
    INSERT LS_STYLE INTO TABLE LT_STYLE.
    LS_STYLE-FIELDNAME = 'UPDTIME'.
    "LS_STYLE-STYLE = CL_GUI_ALV_GRID=>MC_STYLE_DISABLED.
    INSERT LS_STYLE INTO TABLE LT_STYLE.
    "LS_STYLE-STYLE = CL_GUI_ALV_GRID=>MC_STYLE_ENABLED.
    LS_STYLE-FIELDNAME = 'UPDUSR'.
    INSERT LS_STYLE INTO TABLE LT_STYLE.
    LS_STYLE-FIELDNAME = 'CRTDATE'.
    INSERT LS_STYLE INTO TABLE LT_STYLE.
    "LS_STYLE-STYLE = CL_GUI_ALV_GRID=>MC_STYLE_ENABLED.
    LS_STYLE-FIELDNAME = 'CRTTIME'.
    "LS_STYLE-STYLE = CL_GUI_ALV_GRID=>MC_STYLE_DISABLED.
    INSERT LS_STYLE INTO TABLE LT_STYLE.
    LS_STYLE-FIELDNAME = 'CRTUSR'.
    INSERT LS_STYLE INTO TABLE LT_STYLE.
    LS_STYLE-FIELDNAME = 'NEW'.
    INSERT LS_STYLE INTO TABLE LT_STYLE.

    "
