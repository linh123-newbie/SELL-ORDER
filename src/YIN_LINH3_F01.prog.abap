FORM GET_DATA.
  SELECT DONH~CONGTY,
    DONH~DHID,
    DONH~NGAYDH,
    DONH~NGAYGIAO,
    DONH~KHACHHANG,
    KH~NAME1,
    DONH~TRANGTHAI,
    DOND~ITNUM,
    HANG~HHID,
    HANG~MAHANG,
    HANG~TENHANG,
    DOND~DVT,
    DOND~SOLUONG,
    DOND~DONGIA,
    DOND~TIENTE,
    "THANHTIEN,
    HANG~MOTA,
    DONH~GHICHU

    FROM YTB_HANG AS HANG
    LEFT JOIN YTB_DOND AS DOND ON DOND~HHID = HANG~HHID
    LEFT JOIN YTB_DONH AS DONH ON DONH~DHID = DOND~DHID
    INNER JOIN KNA1 AS KH ON KH~KUNNR = DONH~KHACHHANG

*    FROM YTB_DOND AS DOND
*    INNER JOIN YTB_HANG AS HANG ON DOND~HHID = HANG~HHID
*    INNER JOIN YTB_DONH AS DONH ON DOND~DHID = DONH~DHID

    WHERE DONH~CONGTY IN @S_CONGTY
    AND DONH~NGAYDH IN @S_NGAYDH
    AND DONH~KHACHHANG IN @S_KH
    AND DONH~DHID IN @S_DHID
    AND DONH~TRANGTHAI IN @S_TT

*    WHERE MRC~WERKS IN @S_WERKS
*     AND MRA~MATNR IN @S_MATNR

    INTO CORRESPONDING FIELDS OF TABLE @GT_ALV.

  IF GT_ALV[] IS INITIAL.
    MESSAGE 'No data found.' TYPE 'S'.
    STOP.
  ELSE.
  ENDIF.

  "break point.

ENDFORM.

FORM CAL_THANHTIEN.
  LOOP AT GT_ALV ASSIGNING FIELD-SYMBOL(<LS_DETAIL>).
    <LS_DETAIL>-THANHTIEN = <LS_DETAIL>-SOLUONG * <LS_DETAIL>-DONGIA.
  ENDLOOP.
ENDFORM.

FORM BUILD_FCAT_ALV.
  CLEAR GT_FIELDCAT[].

  DATA: LW_COLTEXT TYPE TEXT255.
  FIELD-SYMBOLS: <LF_FCAT> LIKE LINE OF GT_FIELDCAT.


  GS_LAYOUT-CWIDTH_OPT = 'X'.
  GS_LAYOUT-STYLEFNAME = 'STYLE'.

  CALL FUNCTION 'LVC_FIELDCATALOG_MERGE'
    EXPORTING
      I_STRUCTURE_NAME = 'YST_LINH3_MATERIAL'
    CHANGING
      CT_FIELDCAT      = GT_FIELDCAT
                         EXCEPTIONS
                         INCONSISTENT_INTERFACE=1
                         PROGRAM_ERROR=2
                         OTHERS=3.
  IF SY-SUBRC <> 0.
    MESSAGE ID SY-MSGID TYPE SY-MSGTY NUMBER SY-MSGNO " SHOW NOTIFICATION BASED ON SYSTEM INFORMATION
    WITH SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4. " PASS UP TO 4 VALUES
  ELSE.
    LOOP AT GT_FIELDCAT ASSIGNING <LF_FCAT>.
      CASE <LF_FCAT>-FIELDNAME.
        WHEN 'CHECK'.
          <LF_FCAT>-CHECKBOX = ABAP_TRUE.
          <LF_FCAT>-EDIT = ABAP_TRUE. "TICK/ NO TICK
          LW_COLTEXT = 'Chọn'.
          <LF_FCAT>-KEY = ABAP_TRUE.
          <LF_FCAT>-COL_POS = 1.
        WHEN 'CONGTY'.
          LW_COLTEXT = 'Công ty'.
          <LF_FCAT>-COL_POS = 2.
        WHEN 'DHID'.
          LW_COLTEXT = 'ID Đơn hàng'.
          <LF_FCAT>-COL_POS = 3.
        WHEN 'NGAYDH'.
          LW_COLTEXT = 'Ngày đơn hàng'.
          <LF_FCAT>-COL_POS = 4.
        WHEN 'NGAYGIAO'.
          LW_COLTEXT = 'Ngày giao hàng'.
          <LF_FCAT>-COL_POS = 5.
        WHEN 'KHACHHANG'.
          LW_COLTEXT = 'Khách hàng'.
          <LF_FCAT>-COL_POS = 6.
        WHEN 'NAME1'.
          LW_COLTEXT = 'Tên khách hàng'.
          <LF_FCAT>-COL_POS = 7.
        WHEN 'TRANGTHAI'.
          LW_COLTEXT = 'Trạng thái'.
          <LF_FCAT>-COL_POS = 8.
        WHEN 'ITNUM'.
          LW_COLTEXT = 'Item hàng'.
          <LF_FCAT>-COL_POS = 9.
        WHEN 'HHID'.
          LW_COLTEXT = 'ID hàng hóa'.
          <LF_FCAT>-COL_POS = 10.
        WHEN 'MAHANG'.
          LW_COLTEXT = 'Mã hàng hóa'.
          <LF_FCAT>-COL_POS = 11.
        WHEN 'TENHANG'.
          LW_COLTEXT = 'Tên hàng hóa'.
          <LF_FCAT>-COL_POS = 12.
        WHEN 'DVT'.
          LW_COLTEXT = 'Đơn vị tính'.
          <LF_FCAT>-COL_POS = 13.
        WHEN 'SOLUONG'.
          LW_COLTEXT = 'Số lượng'.
          <LF_FCAT>-COL_POS = 14.
        WHEN 'DONGIA'.
          LW_COLTEXT = 'Đơn giá bán'.
          <LF_FCAT>-COL_POS = 15.
        WHEN 'TIENTE'.
          LW_COLTEXT = 'Tiền tệ'.
          <LF_FCAT>-COL_POS = 16.
        WHEN 'THANHTIEN'.
          LW_COLTEXT = 'Thành tiền'.
          <LF_FCAT>-COL_POS = 17.
        WHEN 'MOTA'.
          LW_COLTEXT = 'Mô tả'.
          <LF_FCAT>-COL_POS = 18.
        WHEN 'GHICHU'.
          LW_COLTEXT = 'Ghi chú'.
          <LF_FCAT>-COL_POS = 19.
        WHEN 'SEL' OR 'DETAIL' OR 'ICON_CHECK'
  OR 'NEW' OR 'CHANGE' OR 'REMOVE' OR 'STYLE'.

          <LF_FCAT>-TECH = ABAP_TRUE.
        WHEN 'NEW'.
          <LF_FCAT>-TECH = ABAP_TRUE.

      ENDCASE.

      IF NOT LW_COLTEXT IS INITIAL.
        CLEAR: <LF_FCAT>-COLDDICTXT,
               <LF_FCAT>-SELDDICTXT,
               <LF_FCAT>-TIPDDICTXT.
        <LF_FCAT>-SCRTEXT_S = LW_COLTEXT.
        <LF_FCAT>-SCRTEXT_M = LW_COLTEXT.
        <LF_FCAT>-SCRTEXT_L = LW_COLTEXT.
        <LF_FCAT>-REPTEXT = LW_COLTEXT.
        <LF_FCAT>-COLTEXT = LW_COLTEXT.
        <LF_FCAT>-SELTEXT = LW_COLTEXT.
        <LF_FCAT>-TOOLTIP = LW_COLTEXT.
        CLEAR LW_COLTEXT.
      ENDIF.
    ENDLOOP.
  ENDIF.

ENDFORM.

