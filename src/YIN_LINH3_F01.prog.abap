FORM CHANGE_ORDER .

  DATA: LS_STYLE TYPE LVC_S_STYL,
        LT_STYLE TYPE LVC_t_STYL.
  DATA: LS_OUTTAB LIKE GS_ALV.
  DATA: LS_ERROR  TYPE CHAR1 .
  DATA: LI_COUNT  TYPE I.
  DATA: IDX_HEADER  TYPE SY-TABIX .

  GR_GRID->CHECK_CHANGED_DATA( ).

  LOOP AT GT_ALV ASSIGNING FIELD-SYMBOL(<LS_ALV>).
    TRANSLATE <LS_ALV>-CHECK TO UPPER CASE.
  ENDLOOP.

  LI_COUNT = 0.
  READ TABLE GT_ALV TRANSPORTING NO FIELDS
    WITH KEY CHECK = ABAP_TRUE.

  IF SY-SUBRC <> 0.
    MESSAGE 'Choose 1 order' TYPE 'S' DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  LI_COUNT = 0.
  READ TABLE GT_ALV TRANSPORTING NO FIELDS WITH KEY CHECK = ABAP_TRUE.
  IF SY-SUBRC <> 0.
    MESSAGE 'Choose 1 order' TYPE 'S' DISPLAY LIKE 'E'.
    RETURN.
  ELSE.
    LOOP AT GT_ALV INTO DATA(LS_OUTTAB_CHECK) WHERE CHECK = ABAP_TRUE.
      LI_COUNT = LI_COUNT + 1.
    ENDLOOP.
  ENDIF.

  IF LI_COUNT >= 2.
    MESSAGE 'Choose only 1 order' TYPE 'S' DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  CLEAR: GS_HEADER, GW_SAVE.
  READ TABLE GT_ALV INTO LS_OUTTAB WITH KEY CHECK = ABAP_TRUE.
  IF SY-SUBRC = 0.
    IDX_HEADER = SY-TABIX.
  ELSE.
    RETURN.
  ENDIF.

  PERFORM GET_HEADER_DETAIL USING LS_OUTTAB 'GET_DATA' CHANGING LS_ERROR .
  IF LS_ERROR = 'X' .
    MESSAGE 'Không lấy được dữ liệu của ID Đơn hàng này' TYPE 'S' DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  G_MODE_INS_UPD_DEL = 'U' .
  PERFORM BUILD_FCAT_ALV2 .
  CALL SCREEN 3000.

  LOOP AT GT_ALV ASSIGNING FIELD-SYMBOL(<FS_OUT>).
    <FS_OUT>-CHeck = ABAP_FALSE.
  ENDLOOP.

  IF GW_SAVE = 'X' .
    "GAN DATA CHO LIST
    PERFORM GET_HEADER_DETAIL USING LS_OUTTAB 'SET_DATA' CHANGING LS_ERROR .
  ENDIF.
  PERFORM REFRESH_ALV.
  CLEAR: GS_HEADER, GS_ALV .
  GW_SAVE = '' .
  G_MODE_INS_UPD_DEL = '' .

ENDFORM.

FORM REFRESH_DATA.
  PERFORM GET_DATA.
  PERFORM REFRESH_ALV.
ENDFORM.
