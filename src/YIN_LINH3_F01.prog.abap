*&---------------------------------------------------------------------*
*& Form REMOVE_GRIDROW
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*& -->  p1        text
*& <--  p2        text
*&---------------------------------------------------------------------*
FORM REMOVE_GRIDROW .

  GREF_ALV_3000->CHECK_CHANGED_DATA( ).
  READ TABLE GT_ALV_3000 TRANSPORTING NO FIELDS WITH KEY CHECK = ABAP_TRUE.


  IF SY-SUBRC <> 0.
    MESSAGE 'Choose 1 item!' TYPE 'S' DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  CALL FUNCTION 'POPUP_TO_CONFIRM'
    EXPORTING
      TITLEBAR              = 'Confirm deleting'
      TEXT_QUESTION         = 'Do you want to delete these rows that selected ?'
      TEXT_BUTTON_1         = 'Yes'
      ICON_BUTTON_1         = 'ICON_OKAY'
      TEXT_BUTTON_2         = 'No'
      ICON_BUTTON_2         = 'ICON_CANCEL'
      DEFAULT_BUTTON        = '2'
      DISPLAY_CANCEL_BUTTON = ''
    IMPORTING
      ANSWER                = LV_ANS
    EXCEPTIONS
      TEXT_NOT_FOUND        = 1
      OTHERS                = 2.
  IF SY-SUBRC <> 0.
    "Implement suitable error handling here
    RETURN.
  ENDIF.

  LOOP AT GT_ALV_3000 ASSIGNING FIELD-SYMBOL(<FS_ALV>)
    WHERE CHECK = ABAP_TRUE.

    IF <FS_ALV>-NEW = ABAP_FALSE.
      DELETE FROM YTB_DOND WHERE DHID = @<FS_ALV>-DHID AND ITNUM = @<FS_ALV>-ITNUM.
    ENDIF.

  ENDLOOP.

  COMMIT WORK.

  DELETE GT_ALV_3000 WHERE CHECK = ABAP_TRUE.
  GREF_ALV_3000->REFRESH_TABLE_DISPLAY( ).

  MESSAGE 'Xóa chi tiết đơn hàng thành công!' TYPE 'S'.

ENDFORM.
