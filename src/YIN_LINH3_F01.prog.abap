FORM CREATE_GRIDROW .
  DATA: LS_STYLE TYPE LVC_S_STYL,
        LT_STYLE TYPE LVC_T_STYL.

  DATA: LV_MAX_ITNUM TYPE YTB_DOND-ITNUM.

  LS_STYLE-STYLE = CL_GUI_ALV_GRID=>MC_STYLE_ENABLED.

  LS_STYLE-FIELDNAME = 'CHECK'.
  INSERT LS_STYLE INTO TABLE LT_STYLE.
  LS_STYLE-FIELDNAME = 'DHID'.
  LS_STYLE-STYLE = CL_GUI_ALV_GRID=>MC_STYLE_DISABLED.
  INSERT LS_STYLE INTO TABLE LT_STYLE.
  LS_STYLE-FIELDNAME = 'ITNUM'.
  INSERT LS_STYLE INTO TABLE LT_STYLE.
  LS_STYLE-FIELDNAME = 'HHID'.
  LS_STYLE-STYLE = CL_GUI_ALV_GRID=>MC_STYLE_ENABLED.
  INSERT LS_STYLE INTO TABLE LT_STYLE.
  LS_STYLE-FIELDNAME = 'MAHANG'.
  LS_STYLE-STYLE = CL_GUI_ALV_GRID=>MC_STYLE_DISABLED.
  INSERT LS_STYLE INTO TABLE LT_STYLE.
  LS_STYLE-FIELDNAME = 'TENHANG'.
  INSERT LS_STYLE INTO TABLE LT_STYLE.
  LS_STYLE-FIELDNAME = 'DVT'.
  INSERT LS_STYLE INTO TABLE LT_STYLE.
  LS_STYLE-FIELDNAME = 'SOLUONG'.
  LS_STYLE-STYLE = CL_GUI_ALV_GRID=>MC_STYLE_ENABLED.
  INSERT LS_STYLE INTO TABLE LT_STYLE.
  LS_STYLE-FIELDNAME = 'DONGIA'.
  INSERT LS_STYLE INTO TABLE LT_STYLE.
  LS_STYLE-FIELDNAME = 'TIENTE'.
  INSERT LS_STYLE INTO TABLE LT_STYLE.
  LS_STYLE-FIELDNAME = 'THANHTIEN'.
  LS_STYLE-STYLE = CL_GUI_ALV_GRID=>MC_STYLE_DISABLED.
  INSERT LS_STYLE INTO TABLE LT_STYLE.
  LS_STYLE-FIELDNAME = 'MOTA'.
  LS_STYLE-STYLE = CL_GUI_ALV_GRID=>MC_STYLE_ENABLED.
  INSERT LS_STYLE INTO TABLE LT_STYLE.
  LS_STYLE-FIELDNAME = 'UPDDATE'.
  LS_STYLE-STYLE = CL_GUI_ALV_GRID=>MC_STYLE_DISABLED.
  INSERT LS_STYLE INTO TABLE LT_STYLE.
  LS_STYLE-FIELDNAME = 'UPDTIME'.
  INSERT LS_STYLE INTO TABLE LT_STYLE.
  LS_STYLE-FIELDNAME = 'UPDUSR'.
  INSERT LS_STYLE INTO TABLE LT_STYLE.
  LS_STYLE-FIELDNAME = 'CRTDATE'.
  INSERT LS_STYLE INTO TABLE LT_STYLE.
  LS_STYLE-FIELDNAME = 'CRTTIME'.
  INSERT LS_STYLE INTO TABLE LT_STYLE.
  LS_STYLE-FIELDNAME = 'CRTUSR'.
  INSERT LS_STYLE INTO TABLE LT_STYLE.
  LS_STYLE-FIELDNAME = 'NEW'.
  INSERT LS_STYLE INTO TABLE LT_STYLE.

  CLEAR GS_ALV_3000.



  SELECT MAX( ITNUM )
    FROM YTB_DOND WHERE DHID = @GS_HEADER-DHID INTO @LV_MAX_ITNUM.
  LOOP AT GT_ALV_3000 ASSIGNING FIELD-SYMBOL(<LS_ROW>).
    IF <LS_ROW>-ITNUM > LV_MAX_ITNUM.
      LV_MAX_ITNUM = <LS_ROW>-ITNUM.
    ENDIF.
  ENDLOOP.

  GS_ALV_3000-DHID = GS_HEADER-DHID.
  GS_ALV_3000-ITNUM = LV_MAX_ITNUM + 1.
  GS_ALV_3000-NEW = ABAP_TRUE.

*  GS_ALV_3000-DHID = GV_MAX_DHID + 1.

  APPEND LINES OF LT_STYLE TO GS_ALV_3000-STYLE.
  GS_ALV_3000-DETAIL = ICON_DISPLAY_TEXT.
  GS_ALV_3000-NEW = ABAP_TRUE.
  GS_ALV_3000-NEW = 'X'.

*  GS_ALV-DVT = 'VND'.
*  GS_ALV_3000-ITNUM = 10.

*  GS_ALV-UPDDATE = SY-UNAME.
*  GS_ALV-UPDTIME = SY-UNAME.
*  GS_ALV_3000-UPDUSR = SY-UNAME.
*  GS_ALV-CRTDATE = SY-UNAME.
*  GS_ALV-CRTTIME = SY-UNAME.
*  GS_ALV_3000-CRTUSR = SY-UNAME.

  APPEND GS_ALV_3000 TO GT_ALV_3000.
  CLEAR GS_ALV_3000.

ENDFORM.
*&---------------------------------------------------------------------*
*& Form SAVE_GRIDDATA
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*& -->  p1        text
*& <--  p2        text
*&---------------------------------------------------------------------*
FORM SAVE_GRIDDATA .
  DATA: LS_TABLE1 TYPE YTB_DOND,
        LT_TABLE1 TYPE TABLE OF YTB_DOND.
  DATA: LS_TABLE2 TYPE YTB_DONH,
        LT_TABLE2 TYPE TABLE OF YTB_DONH.
  DATA: OP_ERROR TYPE CHAR1,
        OP_MESS  TYPE TEXT255.

  GREF_ALV_3000->CHECK_CHANGED_DATA( ).
  GET TIME.
  "-------------------
  LOOP AT GT_ALV_3000 TRANSPORTING NO FIELDS WHERE ( HHID IS INITIAL
                                              OR SOLUONG IS INITIAL
                                                OR DONGIA IS INITIAL
                                                     OR TIENTE IS INITIAL
                                                  OR MOTA IS INITIAL

    )
                                              AND ( CHANGE = ABAP_TRUE OR NEW = ABAP_TRUE ) .
    EXIT.
  ENDLOOP.
  IF SY-SUBRC = 0.
    MESSAGE 'Vui lòng nhập đủ thông tin don hàng' TYPE 'S' DISPLAY LIKE 'E'.
    EXIT.
  ENDIF.

  IF GS_HEADER-KHACHHANG IS INITIAL.
    MESSAGE 'Vui lòng nhập đủ thông tin khách hàng' TYPE 'S' DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  CLEAR LS_TABLE2.
  MOVE-CORRESPONDING GS_HEADER TO LS_TABLE2.


  LS_TABLE2-CONGTY = S_CONGTY-LOW.
  LS_TABLE2-MANDT  = SY-MANDT.
  LS_TABLE2-UPDDATE = SY-DATUM.
  LS_TABLE2-UPDTIME = SY-UZEIT.
  LS_TABLE2-UPDUSR  = SY-UNAME.
  LS_TABLE2-CRTDATE = SY-DATUM.
  LS_TABLE2-CRTTIME = SY-UZEIT.
  LS_TABLE2-CRTUSR  = SY-UNAME.

  APPEND LS_TABLE2 TO LT_TABLE2.

*
*  SELECT MAX( ITNUM )
*FROM YTB_DOND WHERE DHID = @GS_HEADER-DHID INTO @GV_MAX_ITNUM.

*  LOOP AT GT_ALV_3000 ASSIGNING FIELD-SYMBOL(<FS_ALV>) WHERE CHANGE = ABAP_TRUE OR NEW = ABAP_TRUE OR REMOVE = ABAP_TRUE.
  LOOP AT GT_ALV_3000 ASSIGNING FIELD-SYMBOL(<FS_ALV>) WHERE CHANGE = ABAP_TRUE OR NEW = ABAP_TRUE.

    CLEAR LS_TABLE1.
    MOVE-CORRESPONDING <FS_ALV> TO LS_TABLE1.

    LS_TABLE1-MANDT  = SY-MANDT.
    LS_TABLE1-DHID = GS_HEADER-DHID.

    IF <FS_ALV>-NEW = ABAP_TRUE .

*      LS_TABLE1-ITNUM = GV_MAX_ITNUM + 1.
      <FS_ALV>-ITNUM = LS_TABLE1-ITNUM.
      LS_TABLE1-UPDDATE = SY-DATUM.
      LS_TABLE1-UPDTIME = SY-UZEIT.
      LS_TABLE1-UPDUSR  = SY-UNAME.
      LS_TABLE1-CRTDATE = SY-DATUM.
      LS_TABLE1-CRTTIME = SY-UZEIT.
      LS_TABLE1-CRTUSR  = SY-UNAME.


    ELSEIF <FS_ALV>-CHANGE = ABAP_TRUE.

      LS_TABLE1-ITNUM = <FS_ALV>-ITNUM.
      LS_TABLE1-UPDDATE = SY-DATUM.
      LS_TABLE1-UPDTIME = SY-UZEIT.
      LS_TABLE1-UPDUSR  = SY-UNAME.

    ELSEIF <FS_ALV>-REMOVE = ABAP_TRUE.

      DELETE FROM YTB_DOND
      WHERE DHID = <FS_ALV>-DHID.

      CONTINUE.

    ENDIF.

    APPEND LS_TABLE1 TO LT_TABLE1.


  ENDLOOP.
  "
  IF LT_TABLE1[] IS NOT INITIAL .
    MODIFY YTB_DOND FROM TABLE LT_TABLE1.
    MODIFY YTB_DONH FROM TABLE LT_TABLE2.
    IF SY-SUBRC = 0.
      COMMIT WORK .
      PERFORM REFRESH_GRID USING 'AFTER_SAVE'.
      PERFORM REFRESH_ALV_AFTER_SAVE.
      MESSAGE 'Save data successfully!' TYPE 'S' .
    ENDIF.
  ELSE.
    PERFORM REFRESH_ALV_AFTER_SAVE.
    MESSAGE 'Data have not been edited !' TYPE 'S' .
  ENDIF.
ENDFORM.
