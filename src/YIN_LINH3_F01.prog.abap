FORM USER_COMMAND_2000.

  LV_OKCODE = G_OKCODE.
  CLEAR G_OKCODE.

  CASE LV_OKCODE.
    WHEN '&SLALL'.
      PERFORM SELECT_ALL.
    WHEN '&DESLALL'.
      PERFORM DESELECT_ALL.
    WHEN '&CRT'.
      PERFORM CREATE_ORDER.
    WHEN '&CHA'.
      PERFORM CHANGE_ORDER.
    WHEN '&SAV'.
*    WHEN '&DELE'.

    WHEN OTHERS.
  ENDCASE.
  CLEAR: OKCODE.

ENDFORM.

FORM USER_COMMAND_3000.

  LV_OKCODE = OKCODE.

  CASE LV_OKCODE.
    WHEN '&SAVE'.
      CALL FUNCTION 'POPUP_TO_CONFIRM'
        EXPORTING
          TITLEBAR              = 'Confirm save'
          TEXT_QUESTION         = 'Do you want to save these information ?'
          TEXT_BUTTON_1         = 'Yes'
          ICON_BUTTON_1         = 'ICON_OKAY'
          TEXT_BUTTON_2         = 'No'
          ICON_BUTTON_2         = 'ICON_CANCEL'
          DEFAULT_BUTTON        = '2'
          DISPLAY_CANCEL_BUTTON = ''
        IMPORTING
          ANSWER                = LV_ANS
        EXCEPTIONS
          TEXT_NOT_FOUND        = 1
          OTHERS                = 2.
      IF SY-SUBRC <> 0.
*       Implement suitable error handling here
      ENDIF.
      IF LV_ANS EQ '1'.
        PERFORM SAVE_GRIDDATA.
        PERFORM REFRESH_ALV_DT.
      ENDIF.

    WHEN OTHERS.
  ENDCASE.
  CLEAR: OKCODE.

ENDFORM.

